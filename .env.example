MAIL_FROM=
MAIL_PASSWORD=

# ----------------------------
# main job
# ----------------------------
MAIL_TO=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ----------------------------
# special job
# ----------------------------
SPECIAL_NEWS_MAIL_TO=
SPECIAL_NEWS_MAIL_CC=
SPECIAL_NEWS_MAIL_BCC=
SPECIAL_NEWS_MAIL_SUBJECT_PREFIX=
NOTION_SPECIAL_NEWS_ENABLED=false
NOTION_TOKEN=
NOTION_SPECIAL_NEWS_DB_ID=

# ----------------------------
# direct-site job
# ----------------------------
DIRECT_SITE_MAIL_TO=
DIRECT_SITE_MAIL_CC=
DIRECT_SITE_MAIL_BCC=
DIRECT_SITE_MAIL_SUBJECT_PREFIX=【サイト更新一覧】
NOTION_DIRECT_SITES_ENABLED=false
NOTION_DIRECT_SITES_DB_ID=

# ----------------------------
# nikkei job（追加）
# ----------------------------
NIKKEI_ENABLED=true
NIKKEI_EMAIL=
NIKKEI_PASSWORD=
NIKKEI_SESSION_STATE_JSON=
NIKKEI_SAVE_FULL_TEXT=false
NIKKEI_SAVE_IMAGES=false
NIKKEI_MAX_ARTICLES=120
NIKKEI_MAX_IMPORTANT_ARTICLES=10
NOTION_DAILY_NEWS_DB_ID=
NOTION_ARTICLE_DB_ID=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_CC=
MAIL_BCC=

NIKKEI_ENABLE_FINAL_REPORT=true
NIKKEI_ENABLE_ARTICLE_GPT_ENRICHMENT=true
NIKKEI_FORCE_ARTICLE_GPT_REPROCESS=false
NIKKEI_ARTICLE_GPT_MODEL=gpt-5.1-mini
NIKKEI_ARTICLE_GPT_MAX_OUTPUT_TOKENS=1200
NIKKEI_ARTICLE_GPT_TEMPERATURE=0.2
NIKKEI_ENABLE_FINAL_REPORT_GPT=true
NIKKEI_FINAL_REPORT_MODEL=gpt-5.1-mini
NIKKEI_FINAL_REPORT_MAX_OUTPUT_TOKENS=1800
NIKKEI_FINAL_REPORT_TEMPERATURE=0.2
NIKKEI_FORCE_FINAL_REPORT_REGENERATE=false
NIKKEI_SEND_FINAL_REPORT_MAIL=true
NIKKEI_SAVE_FINAL_REPORT_TO_NOTION=true
NIKKEI_PREVENT_DUPLICATE_FINAL_REPORT_MAIL=true
NIKKEI_FINAL_REPORT_SUBJECT_PREFIX=【日経事業ブリーフ】
NIKKEI_ALLOW_FALLBACK_FINAL_REPORT_MAIL=false
